{
  "changelog_format_version_enforced": true,
  "targets": [
    "go",
    {
      "name": "npm",
      "path": "npm/"
    },
    {
      "name": "pypi",
      "path": "pypi/"
    }
  ],
  "homebrew": {
    "tap": "homebrew-tap",
    "description": "AI-first safe rm replacement",
    "license": "MIT"
  },
  "publish_mode": "ci",
  "push_timeout": 120,
  "pipelines": {
    "go": {
      "type": "go",
      "target": "go",
      "local": true,
      "install_paths": [
        "."
      ],
      "artifact": "binary"
    },
    "npm": {
      "type": "npm",
      "target": "npm",
      "local": false,
      "provenance": true
    },
    "pypi": {
      "type": "pypi",
      "target": "pypi",
      "local": false
    }
  }
}
