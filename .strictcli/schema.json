{
  "commands": {
    "delete": {
      "args": [
        {
          "help": "Files or directories to archive",
          "name": "files",
          "variadic": true
        }
      ],
      "flags": [
        {
          "default": false,
          "help": "Allow deletion of directories",
          "name": "recursive",
          "negatable": true,
          "short": "r",
          "type": "bool"
        },
        {
          "default": false,
          "help": "Ignore nonexistent files",
          "name": "ignore-missing",
          "negatable": true,
          "short": "f",
          "type": "bool"
        },
        {
          "default": false,
          "help": "Prompt before each deletion",
          "name": "interactive",
          "negatable": true,
          "short": "i",
          "type": "bool"
        },
        {
          "help": "Why this deletion is happening",
          "name": "description",
          "type": "str"
        },
        {
          "default": "",
          "help": "The original bash command that triggered this",
          "name": "command",
          "type": "str"
        },
        {
          "help": "Additional metadata as key=value",
          "name": "meta",
          "repeatable": true,
          "type": "str"
        },
        {
          "default": true,
          "help": "Update the git index after archiving",
          "name": "update-git-index",
          "negatable": true,
          "type": "bool"
        }
      ],
      "help": "Archive files safely (instead of rm)",
      "name": "delete"
    },
    "info": {
      "args": [
        {
          "help": "ID of the archived item",
          "name": "id"
        }
      ],
      "help": "Show full metadata for a deletion",
      "name": "info"
    },
    "list": {
      "flags": [
        {
          "default": "",
          "help": "Filter by path glob pattern",
          "name": "path",
          "type": "str"
        },
        {
          "default": false,
          "help": "Include already-restored items",
          "name": "all",
          "negatable": true,
          "type": "bool"
        }
      ],
      "help": "List archived items",
      "name": "list"
    },
    "purge": {
      "args": [
        {
          "help": "Specific IDs to purge",
          "name": "ids",
          "required": false,
          "variadic": true
        }
      ],
      "flags": [
        {
          "default": "",
          "help": "Purge items older than duration (e.g., 30d, 24h, 1w)",
          "name": "older-than",
          "type": "str"
        },
        {
          "default": "",
          "help": "Only purge items larger than this size (e.g. 100MB, 1GB)",
          "name": "larger-than",
          "type": "str"
        },
        {
          "default": false,
          "help": "Skip confirmation prompt",
          "name": "skip-confirmation",
          "negatable": true,
          "short": "f",
          "type": "bool"
        },
        {
          "default": false,
          "help": "Purge everything",
          "name": "all",
          "negatable": true,
          "type": "bool"
        },
        {
          "default": false,
          "help": "Show what would be purged without deleting",
          "name": "dry-run",
          "negatable": true,
          "type": "bool"
        }
      ],
      "help": "Permanently remove items from archive",
      "name": "purge"
    },
    "undelete": {
      "args": [
        {
          "help": "Numeric ID or original file path to restore",
          "name": "target"
        }
      ],
      "flags": [
        {
          "default": false,
          "help": "Overwrite existing file at destination",
          "name": "force-overwrite",
          "negatable": true,
          "type": "bool"
        }
      ],
      "help": "Restore a file from archive",
      "name": "undelete"
    }
  },
  "config": true,
  "config_fields": {
    "archive_dir": {
      "help": "Directory where deleted files are archived. Default derives from SAFERM_HOME (an infrastructure override: unlike config values, SAFERM_HOME is NOT suppressed by --hermetic).",
      "required": true,
      "type": "str"
    },
    "db_path": {
      "help": "Path to the SQLite database. Default derives from SAFERM_HOME (an infrastructure override: unlike config values, SAFERM_HOME is NOT suppressed by --hermetic).",
      "required": true,
      "type": "str"
    }
  },
  "defaults": {
    "app": {
      "commands": {},
      "config": false,
      "deprecated": {},
      "env_prefix": null,
      "global_flags": [],
      "groups": {},
      "tag_contracts": {}
    },
    "arg": {
      "choices": null,
      "default": null,
      "required": true,
      "type": "str",
      "variadic": false
    },
    "command": {
      "args": [],
      "constraints": [],
      "flags": [],
      "hidden": false,
      "interactive": false,
      "passthrough": false,
      "tags": []
    },
    "flag": {
      "choices": null,
      "default": null,
      "env": null,
      "env_separator": null,
      "hidden": false,
      "negatable": null,
      "repeatable": false,
      "short": null,
      "unique": false
    },
    "group": {
      "commands": {},
      "deprecated": {},
      "groups": {},
      "hidden": false,
      "tags": []
    },
    "schema_version": 1
  },
  "env_prefix": "SAFERM",
  "global_flags": [
    {
      "default": false,
      "help": "Enable verbose output",
      "name": "verbose",
      "negatable": true,
      "type": "bool"
    },
    {
      "conflict_mode": "error",
      "default": "/home/m/.saferm/archive",
      "help": "Path to the archive directory",
      "name": "archive-dir",
      "type": "str"
    },
    {
      "conflict_mode": "error",
      "default": "/home/m/.saferm/db/saferm.db",
      "help": "Path to the SQLite database",
      "name": "db-path",
      "type": "str"
    },
    {
      "default": [
        "(?i)token",
        "(?i)secret",
        "(?i)password",
        "(?i)key",
        "(?i)credential"
      ],
      "help": "Regex patterns for env vars to exclude from metadata",
      "name": "exclude-env-patterns",
      "repeatable": true,
      "type": "str",
      "unique": true
    }
  ],
  "groups": {
    "config": {
      "commands": {
        "edit": {
          "help": "Open the config file for manual editing in $EDITOR (creates if missing)",
          "interactive": true,
          "name": "edit"
        },
        "init": {
          "help": "Generate a template config file with documented fields and defaults",
          "name": "init"
        },
        "path": {
          "help": "Print the absolute path to the config file for this application",
          "name": "path"
        },
        "set": {
          "args": [
            {
              "help": "The config key to set, matching a registered flag name",
              "name": "key"
            },
            {
              "help": "Value to set (comma-separated for repeatable flags, use backslash to escape commas)",
              "name": "value",
              "required": false
            }
          ],
          "flags": [
            {
              "default": false,
              "help": "Clear a repeatable flag by setting its value to an empty list",
              "name": "clear",
              "negatable": true,
              "type": "bool"
            },
            {
              "default": false,
              "help": "Reset a key to its default value by removing it from the config file",
              "name": "default",
              "negatable": true,
              "type": "bool"
            }
          ],
          "help": "Set a persistent config value that overrides the default for a flag",
          "name": "set"
        },
        "show": {
          "constraints": [
            {
              "flags": [
                "plain",
                "json"
              ],
              "type": "mutex"
            }
          ],
          "flags": [
            {
              "default": false,
              "help": "Display config values in a human-readable table format",
              "name": "plain",
              "negatable": true,
              "type": "bool"
            },
            {
              "default": false,
              "help": "Display config values as a JSON object with source metadata",
              "name": "json",
              "negatable": true,
              "type": "bool"
            }
          ],
          "help": "Show all config values with their sources (config file, env, or default)",
          "name": "show"
        }
      },
      "help": "Manage persistent configuration values stored in the config file",
      "name": "config"
    }
  },
  "help": "AI-first safe rm replacement",
  "name": "saferm",
  "project_id": "github.com/smm-h/saferm",
  "schema_version": 1,
  "version": "0.6.2"
}
